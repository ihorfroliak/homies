# Reproducible backend test runtime on the supported Python (PR-001).
#
# The same interpreter family as CI (actions/setup-python 3.12) and as the
# production image (python:3.12-slim), plus what the test suite needs and a
# developer laptop may lack: the dev extras and a PostgreSQL 16 client
# (pg_dump/pg_restore for the backup/restore drill — a client older than the
# server refuses to dump it). Source is bind-mounted, not copied, so the image
# only changes when dependencies do.
#
#   docker build -f ops/test/Dockerfile.py312 -t homies-test-py312 backend
#   docker run --rm -v "$PWD/backend:/src" -w /src \
#     -e TEST_DATABASE_URL=postgresql+psycopg://homies:homies@<db-host>:5432/homies_ci \
#     homies-test-py312 python -m pytest -q
#
# See docs/production/CI-AND-RUNTIME.md.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
      https://www.postgresql.org/media/keys/ACCC4CF8.asc \
 && . /etc/os-release \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-16 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /deps
COPY pyproject.toml constraints.txt ./
# Dependencies only (the package itself is the bind-mounted source), pinned to
# the verified set in constraints.txt — the same set CI and the app image use.
RUN mkdir -p app && touch app/__init__.py \
 && pip install --no-cache-dir -c constraints.txt ".[dev]" \
 && pip uninstall -y homies-backend \
 && rm -rf app

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/src
WORKDIR /src
